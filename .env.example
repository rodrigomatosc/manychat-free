# Copie estes nomes para Vercel > Settings > Environment Variables

# Token de acesso gerado no app da Meta (produto Instagram)
TOKEN_INSTAGRAM=

# Uma senha qualquer que você inventa. Use a mesma no webhook da Meta.
SENHA_WEBHOOK=minhasenha123

# Palavra-chave (pode ser mais de uma, separadas por vírgula)
PALAVRA_CHAVE=QUERO,LINK

# Texto da DM enviada
MENSAGEM_DM=Oi! Aqui está o link que você pediu: https://exemplo.com

# Opcional: resposta pública no comentário (deixe vazio para não responder)
RESPOSTA_PUBLICA=Te mandei no direct! 📩
